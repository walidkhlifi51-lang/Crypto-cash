{
  "expo": {
    "name": "CryptoCashTapToPay",
    "slug": "cryptocash-tap-to-pay",
    "scheme": "cryptocash",
    "owner": "",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.cryptocashtaptopay"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.example.cryptocashtaptopay",
      "permissions": ["USE_FINGERPRINT", "USE_BIOMETRIC"]
    },
    "extra": {
      "eas": {
        "projectId": "local-dev"
      }
    }
  }
}
